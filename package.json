{
  "name": "designer-mcp-docker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Containerised design-system MCP server with a live offline thumbnail gallery",
  "license": "MIT",
  "scripts": {
    "fetch": "node scripts/refero-public-fetch.js",
    "fetch:quick": "node scripts/refero-public-fetch.js --limit 60",
    "opendesign": "node scripts/fetch-opendesign.mjs",
    "thumbs": "node scripts/fetch-thumbs.mjs --compress",
    "thumbs:raw": "node scripts/fetch-thumbs.mjs",
    "compress": "node scripts/compress-thumbs.mjs",
    "all": "npm run fetch && npm run opendesign && npm run thumbs",
    "preview": "node scripts/preview.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "build": "docker build -t designer-mcp:latest .",
    "update": "node scripts/update.mjs --yes",
    "update:dry": "node scripts/update.mjs --dry-run",
    "publish": "node scripts/update.mjs --publish --yes",
    "package:skill": "node scripts/package-skill.mjs",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "test": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "fidgetcoding-refero-mcp": "^0.2.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=20"
  }
}
