{
  "id": "realtime-ops-telemetry",
  "name": "Real-Time Ops, AI & Telemetry Console",
  "starter": "nextjs-tailwind",
  "framework": "nextjs",
  "useCase": "realtime-ops-ai",
  "slots": {
    "framework": "Next.js 16 (App Router) + TypeScript",
    "styling": "Tailwind CSS v4 + OpenDesign OKLCH tokens",
    "uiPrimitives": "Native Top-Layer / Base UI",
    "charts": "ApexCharts (<LiveChart> streaming + 24 presets)",
    "tables": "TanStack React Table (server-mode <DataGrid>)",
    "forms": "React Hook Form + Zod",
    "dataFetching": "TanStack React Query + SSE/WebSocket",
    "state": "Zustand",
    "urlState": "Nuqs (shareable filter/time-window URLs)",
    "commandPalette": "kbar",
    "auth": "Better Auth / Clerk / Mock",
    "errorTracking": "Sentry",
    "lintFormat": "OxLint + Oxfmt",
    "gitHooks": "Husky + lint-staged",
    "theming": "OpenDesign (obsidian / glacier / twilight)"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@sentry/nextjs": "^9.12.0",
    "apexcharts": "^8.9.1",
    "react-apexcharts": "^2.2.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.78.0",
    "sonner": "^2.0.8",
    "zustand": "^5.1.0",
    "nuqs": "^2.10.3",
    "kbar": "^0.1.0-beta.47",
    "react-hook-form": "^7.92.0",
    "@hookform/resolvers": "^7.0.8",
    "zod": "^4.6.7",
    "next-intl": "^4.15.3",
    "dayjs": "^1.11.23",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "oxlint": "^1.94.0",
    "oxfmt": "^0.79.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "@playwright/test": "^1.65.1",
    "@axe-core/playwright": "^4.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "tokens:build": "node design-system/scripts/build-tokens.mjs design-system",
    "tokens:check": "node design-system/scripts/build-tokens.mjs design-system --check"
  },
  "envVars": {
    "NEXT_PUBLIC_SENTRY_DSN": "",
    "SENTRY_AUTH_TOKEN": ""
  },
  "tooling": {
    "oxlint": true,
    "oxfmt": true,
    "husky": true
  }
}
