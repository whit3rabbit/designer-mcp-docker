{
  "id": "react-vite-mui",
  "name": "React 19 + Vite 8 + Material UI (Enterprise)",
  "starter": "react-vite-mui",
  "framework": "react-mui",
  "useCase": "enterprise-complex-apps",
  "slots": {
    "framework": "React 19 + Vite 8 + React Router",
    "styling": "Material UI v7 (Emotion) + OpenDesign OKLCH tokens",
    "uiPrimitives": "Material UI (@mui/material)",
    "charts": "ApexCharts",
    "tables": "TanStack React Table + MUI Table",
    "forms": "React Hook Form + Zod",
    "dataFetching": "TanStack React Query",
    "state": "Zustand",
    "urlState": "React Router searchParams",
    "auth": "Custom JWT + HttpOnly cookies / Auth0 / Clerk",
    "errorTracking": "Optional Sentry",
    "lintFormat": "ESLint + jsx-a11y",
    "theming": "MUI createTheme (cssVariables: true) + OpenDesign 21 WCAG AA presets"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@mui/material": "^7.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.13.5",
    "react-router": "^8.5.2",
    "apexcharts": "^8.9.1",
    "react-apexcharts": "^2.2.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.78.0",
    "zustand": "^5.1.0",
    "react-hook-form": "^7.92.0",
    "@hookform/resolvers": "^7.0.8",
    "zod": "^4.6.7",
    "i18next": "^27.2.4",
    "react-i18next": "^18.0.3",
    "dayjs": "^1.11.23",
    "sonner": "^2.0.8",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "tokens:build": "node design-system/scripts/build-tokens.mjs design-system",
    "tokens:check": "node design-system/scripts/build-tokens.mjs design-system --check"
  },
  "envVars": {
    "VITE_API_BASE_URL": "http://localhost:4000/api",
    "VITE_DATA_MODE": "mock"
  },
  "tooling": {}
}
