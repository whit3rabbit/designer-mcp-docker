{
  "id": "nextjs-rabbit-default",
  "name": "Next.js 16 Lean Default (Designer Dashboards)",
  "starter": "nextjs-tailwind",
  "framework": "nextjs",
  "useCase": "general-saas",
  "slots": {
    "framework": "Next.js 16 (App Router) + TypeScript",
    "styling": "Tailwind CSS v4 + OpenDesign OKLCH tokens",
    "uiPrimitives": "Native Top-Layer (<dialog>/Popover) or Radix UI",
    "charts": "ApexCharts (24+ presets + <LiveChart>)",
    "tables": "TanStack React Table (<DataGrid>)",
    "forms": "React Hook Form + Zod",
    "dataFetching": "Next.js Server Components + Server Actions",
    "state": "Zustand",
    "urlState": "Next.js searchParams",
    "commandPalette": "Built-in CommandPalette",
    "auth": "Auth.js / Better Auth / Supabase / Mock",
    "errorTracking": "None (add Sentry for prod)",
    "lintFormat": "ESLint + jsx-a11y + _adherence.oxlintrc.json",
    "gitHooks": "None",
    "theming": "OpenDesign 21 WCAG AA presets"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "apexcharts": "^8.9.1",
    "react-apexcharts": "^2.2.1",
    "@tanstack/react-table": "^9.3.1",
    "lucide-react": "^1.78.0",
    "sonner": "^2.0.8",
    "zustand": "^5.1.0",
    "react-hook-form": "^7.92.0",
    "@hookform/resolvers": "^7.0.8",
    "zod": "^4.6.7",
    "next-intl": "^4.15.3",
    "dayjs": "^1.11.23",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript-eslint": "^8.73.0",
    "@playwright/test": "^1.65.1",
    "@axe-core/playwright": "^4.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tokens:build": "node design-system/scripts/build-tokens.mjs design-system",
    "tokens:check": "node design-system/scripts/build-tokens.mjs design-system --check"
  },
  "envVars": {},
  "tooling": {}
}
