{
  "id": "nextjs-shadcn-enterprise",
  "name": "Next.js 16 + shadcn (Base UI) + TanStack + Clerk + Sentry",
  "starter": "nextjs-tailwind",
  "framework": "nextjs",
  "useCase": "production-saas-enterprise",
  "sourceReference": "https://github.com/Kiranism/next-shadcn-dashboard-starter",
  "slots": {
    "framework": "Next.js 16 (App Router) + TypeScript",
    "styling": "Tailwind CSS v4 + tweakcn-compatible OKLCH tokens",
    "uiPrimitives": "shadcn/ui on Base UI (@base-ui/react)",
    "charts": "Recharts + Evil Charts",
    "tables": "TanStack React Table + Dice Table",
    "forms": "TanStack Form + Zod",
    "dataFetching": "TanStack React Query",
    "state": "Zustand",
    "urlState": "Nuqs",
    "commandPalette": "kbar",
    "auth": "Clerk",
    "errorTracking": "Sentry",
    "lintFormat": "OxLint + Oxfmt",
    "gitHooks": "Husky + lint-staged",
    "theming": "tweakcn + OpenDesign design-system/"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^6.14.0",
    "@sentry/nextjs": "^9.12.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^9.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "nuqs": "^2.10.3",
    "kbar": "^0.1.0-beta.47",
    "lucide-react": "^1.78.0",
    "sonner": "^2.0.8",
    "next-intl": "^4.15.3",
    "dayjs": "^1.11.23",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "oxlint": "^1.94.0",
    "oxfmt": "^0.79.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "@playwright/test": "^1.65.1",
    "@axe-core/playwright": "^4.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "tokens:build": "node design-system/scripts/build-tokens.mjs design-system",
    "tokens:check": "node design-system/scripts/build-tokens.mjs design-system --check"
  },
  "envVars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "",
    "CLERK_SECRET_KEY": "",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/login",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/register",
    "NEXT_PUBLIC_SENTRY_DSN": "",
    "SENTRY_AUTH_TOKEN": ""
  },
  "tooling": {
    "oxlint": true,
    "oxfmt": true,
    "husky": true,
    "shadcnBaseUi": true
  }
}
