{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designer-dashboards.local/schemas/nav-ir.schema.json",
  "title": "Designer Dashboards Unified Navigation IR",
  "description": "Primary information architecture schema driving sidebar, horizontal nav, mega-menu, breadcrumbs, page titles, i18n keys, and RBAC route filtering.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/NavItem"
  },
  "$defs": {
    "NavItem": {
      "type": "object",
      "required": ["key", "title", "translateKey", "type"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "item" } }, "required": ["type"] },
          "then": { "required": ["path"] }
        }
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "translateKey": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["title", "group", "collapse", "item"] },
        "icon": { "type": "string", "description": "IconRegistry string key (never JSX)." },
        "path": { "type": "string", "description": "Route href (required for type=item)." },
        "description": { "type": "string" },
        "badge": {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" },
            "color": { "type": "string", "enum": ["primary", "secondary", "success", "warning", "error", "info"] }
          }
        },
        "authority": {
          "type": "array",
          "items": { "type": "string" },
          "description": "RBAC roles allowed to see this menu entry and visit its route."
        },
        "disabled": { "type": "boolean" },
        "expanded": { "type": "boolean", "description": "Initial open state of a collapse group." },
        "pinned": { "type": "boolean", "description": "Also listed in the sidebar Pinned quick-access section." },
        "pinnable": { "type": "boolean", "description": "Allow user to toggle bookmark/shortcut into localStorage." },
        "bottom": { "type": "boolean", "description": "Bottom-of-sidebar zone (settings/logout)." },
        "isExternalLink": { "type": "boolean" },
        "activeUrl": { "type": "string", "description": "Base prefix for dynamic detail routes like /orders/details/:id." },
        "activeOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exact": { "type": "boolean", "description": "Require exact pathname match instead of prefix match." },
            "queryParams": { "type": "string", "enum": ["exact", "ignored"] }
          }
        },
        "quickCreate": {
          "type": "object",
          "required": ["tooltip", "path"],
          "additionalProperties": false,
          "properties": {
            "tooltip": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "collapseLimit": { "type": "integer", "minimum": 1, "description": "Inline Show N more / Show less truncation." },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizontalMenu": { "type": "boolean", "description": "false hides this top-level item from the horizontal navbar." },
            "megaMenu": { "type": "boolean", "description": "Horizontal navbar renders children as mega-menu columns." },
            "horizontalMenuLayout": { "type": "string", "enum": ["dropdown", "columns", "tabs", "thumbnail-grid"] },
            "layout": { "type": "string", "enum": ["vertical", "collapsed", "hover", "horizontal", "two-column", "frameless", "content-overlay", "compact-topbar", "sidebarless"] },
            "container": { "type": "string", "enum": ["fluid", "boxed", "narrow"] },
            "hideHeader": { "type": "boolean" },
            "hideFooter": { "type": "boolean" },
            "promoSlot": { "type": "boolean" }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/NavItem" }
        }
      }
    }
  }
}
