# Dependencies
node_modules/

# Populated by scripts/refero-public-fetch.js — 1,342 style files, ~117MB.
# Populate it outside the container; it is mounted read-only, never baked in.
cache/

# The baked catalog that IS copied into the image (scripts/bake-cache.mjs).
# ~136MB of build output, regenerated by `npm run bake`. Kept out of git
# but deliberately kept in the Docker build context.
bake/

# Built skill archives
dist/

# Local env / secrets
.env
.env.*
!.env.example

# Logs and OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Python bytecode (the audit scripts in the sibling repo are Python; harmless here)
__pycache__/
*.pyc

# macOS cruft beyond .DS_Store
.AppleDouble
.LSOverride

# Custom folder icon file (must end with two \r to match the real thing)
Icon

# Resource forks ("._foo" next to every "foo" on non-HFS volumes)
._*

# Volume metadata that appears when a repo lives on an external/DMG volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories created on remote AFP shares
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
